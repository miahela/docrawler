# Optional defaults. No API keys or accounts are required.
# CLI options override corresponding defaults below.
# Relative paths are resolved from the directory where you run the command.
DOCRAWLER_OUTPUT_DIR=downloads
DOCRAWLER_VISITED_FILE=visited.txt
DOCRAWLER_QUEUE_FILE=queue.txt
DOCRAWLER_LOG_FILE=scraper.log
DOCRAWLER_EXTENSIONS=".pdf .docx .doc .odt"
DOCRAWLER_WORKERS=5
DOCRAWLER_PAGE_TIMEOUT=15
DOCRAWLER_DOWNLOAD_TIMEOUT=30
DOCRAWLER_RETRIES=3
DOCRAWLER_BACKOFF=1.0
# Optional override; leave unset to keep the original browser user agent.
# DOCRAWLER_USER_AGENT=docrawler/1.0
